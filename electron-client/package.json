{
  "name": "vue3sys-client",
  "version": "1.0.0",
  "description": "协作事业部生产管理系统 - 桌面客户端",
  "main": "src/main.js",
  "author": "vue3sys",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:frontend": "node scripts/build-frontend.js",
    "build": "node scripts/build-frontend.js && electron-builder --win portable",
    "build:dir": "node scripts/build-frontend.js && electron-builder --win --dir",
    "build:electron-only": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.vue3sys.client",
    "productName": "协作事业部生产管理系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "frontend/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.png"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
