# 前端生产环境配置（Nginx 托管 dist/ 时使用）
# 说明：
#   - VITE_APP_BASE_API=/prod-api  表示前端构建产物中调用的接口前缀统一为 /prod-api
#   - Nginx 需要把 /prod-api/ 反向代理到后端 8000（不带 /prod-api）
#   - VITE_APP_WS_ENDPOINT 生产环境建议填 wss://your-domain/ws 或 ws://ip/ws
# ================================
# 应用端口（生产构建不使用本端口，仅本地预览时用）
VITE_APP_PORT=3000
# 项目名称
VITE_APP_TITLE=协作事业部生产管理系统
# 生产接口前缀（由 Nginx 反向代理到后端 8000）
VITE_APP_BASE_API=/prod-api
# 接口真实地址（仅在本地 build 预览时使用，Nginx 部署以 VITE_APP_BASE_API 为准）
VITE_APP_API_URL=http://localhost:8000
# WebSocket 端点（生产可填 ws://服务器IP/ws 或 wss://域名/ws；留空=关闭）
VITE_APP_WS_ENDPOINT=
# 关闭 Mock
VITE_MOCK_DEV_SERVER=false
# 关闭多租户
VITE_APP_TENANT_ENABLED=false
